# Copie para .env (o .env não vai para o Git).

# Base da API usada pelo axios. Com o proxy do Vite (dev) ou Nginx (lab/produção)
# o front e a API ficam no mesmo domínio, então o caminho relativo basta.
VITE_API_BASE_URL=/api/v1

# Para onde o Vite repassa /api em desenvolvimento.
VITE_API_PROXY_TARGET=http://localhost:8080

# Lab Docker: porta publicada no host pelo Nginx (única porta exposta).
HTTP_PORT=8080
